# =============================================================================
# .env.example
# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env to version control.
# =============================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=travel_db
DB_USER=etl_user
DB_PASSWORD=your_postgres_password_here

# ── AWS Credentials (IAM user with least-privilege S3 access) ───────────────
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=us-east-1

# ── S3 Bucket Configuration ─────────────────────────────────────────────────
S3_BUCKET_NAME=your-travel-etl-bucket
S3_RAW_KEY=raw/travel_bookings_raw.csv
S3_CLEAN_KEY=clean/travel_bookings_clean.csv

# ── Pipeline Options ─────────────────────────────────────────────────────────
# Set to 'local' to read from data/raw/, 's3' to download from S3 first
ETL_SOURCE=local
